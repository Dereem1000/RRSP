# Local copy of legacy database (portable with this v2 folder)
DATABASE_PATH=./data/computer_dynamics.db

# Strong random secret â€” required for production (never commit this file)
JWT_SECRET=08cb0d8026607f6df12f8f72d83c4ad696467c686bfa196bb4ea4b70dc3e435fb8c6383164cf99bcaca261ef2acf11b6
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Next.js UI (port 3000). API routes are proxied to Express — see CD_API_* below.
PORT=3000

# Express API — all /api/* business routes (apps/api on port 4000).
# Next.js rewrites /api/:path* to CD_API_ORIGIN; keep these for local dev and production.
CD_API_ORIGIN=http://127.0.0.1:4000
CD_API_PORT=4000
CD_API_HOST=127.0.0.1

# License activation system (SQLite) — local copy travels with v2 folder
LICENSE_DB_PATH=./license_activation_system_new/instance/license_system.db

# MSP sync token: manage in portal Settings â†’ Integrations (not in .env unless overriding)

# Google reCAPTCHA for public forms (optional â€” can also set in Settings â†’ Integrations)
# RECAPTCHA_SITE_KEY=your-site-key
# RECAPTCHA_SECRET_KEY=your-secret-key

# License API server (external product validation) â€” started via npm run dev:all
LICENSE_API_PORT=5001
# Next.js proxies /api/license/* to this URL (Cloudflare tunnel mode)
LICENSE_API_INTERNAL_URL=http://127.0.0.1:5001
NEXT_PUBLIC_SITE_URL=https://computerdynamicstt.com

